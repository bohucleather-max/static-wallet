---
import site from "../../data/site.json";

const contacts = site.contacts as Array<{ type: string; label: string; href: string }>;
---

{contacts.length > 0 ? (
  <ul class="contact-links" aria-label="Contact BOHUC">
    {contacts.map((contact) => (
      <li>
        <a href={contact.href} aria-label={contact.label} target={contact.href.startsWith("http") ? "_blank" : undefined} rel={contact.href.startsWith("http") ? "noreferrer" : undefined}>
          <span class="contact-links__icon" aria-hidden="true">
            {contact.type === "email" ? (
              <svg viewBox="0 0 24 24"><path d="M3 5.5h18v13H3zM4 7l8 6 8-6" /></svg>
            ) : contact.type === "messenger" ? (
              <svg viewBox="0 0 24 24"><path d="M12 3a9 8 0 0 0-8.9 8A7.8 7.8 0 0 0 6 17l-.5 4 4-2.2c.8.2 1.7.3 2.5.3a9 8 0 1 0 0-16Zm1 10-2.3-2.4L6.2 13l5-5.2 2.3 2.4L18 7.8Z" /></svg>
            ) : (
              <svg viewBox="0 0 24 24"><path d="M8 12h8M12 8v8M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z" /></svg>
            )}
          </span>
          <span>{contact.label}</span>
        </a>
      </li>
    ))}
  </ul>
) : (
  <div class="contact-pending" role="status">
    <span class="contact-pending__icon" aria-hidden="true">✦</span>
    <div>
      <strong>CONTACT DETAILS COMING SOON</strong>
      <p>{site.contactNotice}</p>
    </div>
  </div>
)}
