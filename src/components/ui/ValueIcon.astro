---
interface Props {
  name: "heart" | "diamond" | "nature" | "shipping" | "trophy" | "service";
}

const { name } = Astro.props;
---

<svg class="value-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === "heart" && <path d="M20.8 4.6a5.4 5.4 0 0 0-7.6 0L12 5.8l-1.2-1.2a5.4 5.4 0 0 0-7.6 7.6L12 21l8.8-8.8a5.4 5.4 0 0 0 0-7.6Z" />}
  {name === "diamond" && (
    <>
      <path d="m12 2 9 6-9 14L3 8l9-6Z" />
      <path d="M3 8h18M7.4 2.9 9 8l3-6 3 6 1.6-5.1M9 8l3 14 3-14" />
    </>
  )}
  {name === "nature" && (
    <>
      <path d="M12 7.2c-2-2.1-6.2-2.2-8 1-3.1 5.5.8 12.8 4.1 12.8 1.4 0 2.2-.8 3.9-.8s2.5.8 3.9.8c3.3 0 7.2-7.3 4.1-12.8-1.8-3.2-6-3.1-8-1Z" />
      <path d="M12.2 6.2c.1-2.3 1.5-3.8 4.1-4.2-.2 2.4-1.6 3.8-4.1 4.2Z" />
    </>
  )}
  {name === "shipping" && (
    <>
      <path d="M2 5.5h12.5v11H2zM14.5 9h4l3.5 4v3.5h-7.5zM14.5 13h7" />
      <circle cx="6" cy="18" r="2" />
      <circle cx="18" cy="18" r="2" />
    </>
  )}
  {name === "trophy" && (
    <>
      <path d="M8 3h8v5c0 3-1.8 5-4 5S8 11 8 8V3ZM8 6H4v2c0 2.2 1.8 4 4 4M16 6h4v2c0 2.2-1.8 4-4 4M12 13v5M8 21h8M9 18h6" />
      <path d="m12 5 1 2 2.2.3-1.6 1.5.4 2.2-2-1-2 1 .4-2.2-1.6-1.5L11 7l1-2Z" />
    </>
  )}
  {name === "service" && (
    <>
      <path d="M3 4h14v10H9l-4 3v-3H3V4Z" />
      <path d="M10 8h11v10h-2v3l-4-3h-5v-4M6 8h8M6 11h5M13 12h5M13 15h5" />
    </>
  )}
</svg>
